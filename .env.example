# Google sign-in for SpotOn staff (@spoton.com only). Set these in Vercel -> Settings -> Environment Variables.
# Without all four the app stays closed and shows "Sign-in isn't set up yet".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=
# The site's public address, e.g. https://nr-nr.vercel.app
NEXTAUTH_URL=
# Local browser tests only (ignored on Vercel): MARGINLAB_AUTH_BYPASS=1
